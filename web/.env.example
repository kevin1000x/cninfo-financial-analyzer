# Build-time browser settings. Public publishable key only, never service_role.
VITE_AUTH_MODE=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Cloudflare Pages runtime settings (set in the dashboard, not browser env):
# AUTH_MODE=supabase
# API_BASE=https://rgt07-cninfo-financial-analyzer.hf.space
# AUDIT_API_BASE=https://rgt07-cninfo-financial-analyzer.hf.space/audit
# AUDIT_API_TOKEN=SERVER_SIDE_ONLY_MATCHING_BACKEND_FINAUDIT_API_TOKEN
# Leave AUDIT_PLATFORM_TOKEN unset for the existing public HF Space.
# legacy only: AUTH_MODE=legacy plus API_TOKEN
# Keep VITE_AUTH_MODE, Pages AUTH_MODE and backend AUTH_MODE aligned.

# Supabase Auth URL Configuration (dashboard):
# Site URL and the sole exact Redirect URL: https://app.rgt7611lab.dpdns.org/
# Pages platform alias: https://cninfo-analyzer-web.pages.dev/ (not an Auth callback).
# Email callbacks use the custom-domain root, without #/audit or a wildcard.

# Optional local development only; not evidence of production integration.
# The same local API serves /jobs and /audit. These are not Pages settings.
# DEV_API_BASE=http://127.0.0.1:8000
# FINAUDIT_API_TOKEN=local-preview-only
